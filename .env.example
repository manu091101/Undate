# ============================================================================
# Lumin — Environment Variables
# Copy to .env.local (apps that read it) or .env (api/db). Never commit secrets.
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ---- Database (Postgres + pgvector) ---------------------------------------
# Use the docker-compose dev DB by default
DATABASE_URL="postgresql://lumin:lumin@localhost:5432/lumin?schema=public"
# Direct URL bypasses connection pooler (required for Prisma migrate)
DIRECT_URL="postgresql://lumin:lumin@localhost:5432/lumin?schema=public"

# ---- Redis (sessions, rate limiting, pub/sub) -----------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO local; S3 in prod) -----------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lumin-media-dev
S3_ACCESS_KEY=lumin-dev
S3_SECRET_KEY=lumin-dev-secret
S3_PUBLIC_URL=http://localhost:9000/lumin-media-dev

# ---- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_COOKIE_NAME=lumin_session

# ---- SMS / Phone verification ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Email (dev: mailpit; prod: Resend / Postmark) ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lumin <hello@lumin.app>"

# ---- Payments (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_INTRO=price_...
STRIPE_PRICE_SIGNATURE=price_...
STRIPE_PRICE_CONCIERGE=price_...

# ---- AI providers ----------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-large
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Web app (Next.js public envs) ----------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Mobile app (Expo public envs) ----------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_POSTHOG_KEY=

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Feature flags ---------------------------------------------------------
FEATURE_CONCIERGE_TIER=true
FEATURE_VIDEO_VIBES=false
