{
  "name": "@undate/cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply undate --local",
    "db:remote": "wrangler d1 migrations apply undate --remote",
    "seed:remote": "wrangler d1 execute undate --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "4.103.0"
  }
}
