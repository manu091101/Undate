2,0,0,1);will-change:transform\"></div><div data-depth=\"0.9\" data-rot=\"0deg\" class=\"absolute right-0 top-2 z-20 animate-float-slow\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] \" style=\"transform:rotate(4deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-beach-dance.png\" alt=\"A couple at golden hour\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-52 w-64 sm:w-72\"/></figure></div><div data-depth=\"0.45\" data-rot=\"0deg\" class=\"absolute left-0 top-28 z-10\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] \" style=\"transform:rotate(-7deg)\"><img src=\"/brand/couple-hands-flower.png\" alt=\"Worth meeting\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-40 w-44\"/></figure></div><div data-depth=\"1.3\" data-rot=\"0deg\" class=\"absolute bottom-0 right-12 z-30\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] \" style=\"transform:rotate(-3deg)\"><img src=\"/brand/couple-beach-run.png\" alt=\"A real smile\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-36 w-40\"/></figure></div><div data-depth=\"1.6\" data-rot=\"0deg\" class=\"absolute -left-2 top-4 z-40\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-gold-500 text-white animate-float-slow \" style=\"transform:rotate(-12deg)\">★ no swiping</span></div><div data-depth=\"1.6\" data-rot=\"0deg\" class=\"absolute bottom-10 left-4 z-40\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-cream-50 text-ink-900  \" style=\"transform:rotate(8deg)\">one match</span></div><div data-depth=\"2\" data-rot=\"0deg\" class=\"absolute -bottom-6 left-1/2 z-40 -translate-x-1/2\" style=\"transition:transform 0.5s cubic-bezier(0.2,0,0,1);will-change:transform\"><svg width=\"104\" height=\"104\" viewBox=\"0 0 200 200\" class=\"animate-spin-slow text-gold-500\" fill=\"none\" aria-hidden=\"true\"><defs><path id=\"seal-circle\" d=\"M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0\"></path></defs><circle cx=\"100\" cy=\"100\" r=\"92\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"0.35\"></circle><circle cx=\"100\" cy=\"100\" r=\"82\" stroke=\"currentColor\" stroke-width=\"1\" opacity=\"0.25\"></circle><text fill=\"currentColor\" font-size=\"14.5\" font-weight=\"700\" letter-spacing=\"3.2\" font-family=\"var(--font-pixel)\"><textPath href=\"#seal-circle\" startOffset=\"0%\">UNDATE · INTENTIONAL MATCHMAKING · </textPath></text><text x=\"100\" y=\"112\" text-anchor=\"middle\" fill=\"currentColor\" font-size=\"46\" font-family=\"var(--font-display)\" font-style=\"italic\">u</text><line x1=\"78\" y1=\"96\" x2=\"122\" y2=\"96\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"></line></svg></div></div></div></div></section><div class=\"border-y-2 border-cream-50/10 bg-gold-500 py-3\"><div class=\"marquee-mask group flex overflow-hidden \"><div class=\"flex shrink-0 animate-marquee items-center gap-4 group-hover:[animation-play-state:paused]\"><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">intentional<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">agentic<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">curated<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">no swiping<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">one match<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">verified<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">private<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">on purpose<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">intentional<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">agentic<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">curated<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">no swiping<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">one match<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">verified<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">private<span class=\"text-ink-900/40\">✦</span></span><span class=\"flex items-center gap-4 px-4 text-lg font-bold uppercase tracking-wider text-ink-900\">on purpose<span class=\"text-ink-900/40\">✦</span></span></div></div></div><section class=\"bg-grid border-b border-cream-50/10\"><div class=\"mx-auto max-w-6xl px-6 py-24\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><p class=\"font-pixel text-2xl text-gold-400\">how it works</p><h2 class=\"mt-2 max-w-xl font-display text-4xl font-light tracking-tight text-cream-50 md:text-5xl\">Four unhurried steps. No swiping, no games.</h2></div><div class=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><article class=\"group h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-7 shadow-soft transition-all duration-base ease-spring hover:-translate-y-1.5 hover:border-gold-500/50 hover:shadow-glow\"><span class=\"inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-black bg-gold-500 font-pixel text-2xl text-white shadow-[3px_3px_0_0_rgba(0,0,0,0.85)]\">01</span><h3 class=\"mt-5 font-display text-xl tracking-tight text-cream-50\">Request access</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">Tell us a little about yourself and what you are looking for. Every member is considered, not automatic.</p></article></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 110ms, transform 0.7s cubic-bezier(0.2,0,0,1) 110ms\"><article class=\"group h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-7 shadow-soft transition-all duration-base ease-spring hover:-translate-y-1.5 hover:border-gold-500/50 hover:shadow-glow\"><span class=\"inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-black bg-gold-500 font-pixel text-2xl text-white shadow-[3px_3px_0_0_rgba(0,0,0,0.85)]\">02</span><h3 class=\"mt-5 font-display text-xl tracking-tight text-cream-50\">Meet your matchmaker</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">A short, natural conversation by voice or text. Your agent learns how you connect and what you actually want, no forms to fill.</p></article></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 220ms, transform 0.7s cubic-bezier(0.2,0,0,1) 220ms\"><article class=\"group h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-7 shadow-soft transition-all duration-base ease-spring hover:-translate-y-1.5 hover:border-gold-500/50 hover:shadow-glow\"><span class=\"inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-black bg-gold-500 font-pixel text-2xl text-white shadow-[3px_3px_0_0_rgba(0,0,0,0.85)]\">03</span><h3 class=\"mt-5 font-display text-xl tracking-tight text-cream-50\">Your agent runs the room</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">It quietly holds mock conversations with other members’ agents, feeling out chemistry and filtering the mismatches.</p></article></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 330ms, transform 0.7s cubic-bezier(0.2,0,0,1) 330ms\"><article class=\"group h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-7 shadow-soft transition-all duration-base ease-spring hover:-translate-y-1.5 hover:border-gold-500/50 hover:shadow-glow\"><span class=\"inline-flex h-12 w-12 items-center justify-center rounded-full border-2 border-black bg-gold-500 font-pixel text-2xl text-white shadow-[3px_3px_0_0_rgba(0,0,0,0.85)]\">04</span><h3 class=\"mt-5 font-display text-xl tracking-tight text-cream-50\">Meet your match</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">One curated introduction, with an honest note on why the two of you clicked. Then the humans take over.</p></article></div></div></div></section><section class=\"relative mx-auto max-w-6xl px-6 py-24\"><div class=\"grid items-center gap-12 md:grid-cols-2\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-gold-300 text-ink-900  mb-5\" style=\"transform:rotate(-4deg)\">the agentic matching ring</span><h2 class=\"font-display text-4xl font-light tracking-tight text-cream-50 md:text-5xl\">Your agent meets theirs, <span class=\"italic text-gold-300\">before you ever do.</span></h2><p class=\"mt-6 max-w-md leading-relaxed text-cream-50/70\">From your conversation we build a private AI persona of you. Each cycle it ranks everyone in your pool, then runs short mock conversations with the closest handful of agents to see who would actually hold up over dinner.</p><p class=\"mt-4 max-w-md leading-relaxed text-cream-50/70\">Its real job is subtraction: it rules out the dealbreakers, the attachment traps and the quiet red flags, so the one introduction you get is someone you could never have ruled out yourself. Then the humans take over.</p></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 120ms, transform 0.7s cubic-bezier(0.2,0,0,1) 120ms\"><div class=\"relative rounded-2xl border-2 border-gold-500/30 bg-ink-700 p-6 shadow-glow\"><div class=\"pointer-events-none absolute -right-3 -top-3\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-gold-500 text-white  \" style=\"transform:rotate(10deg)\">live</span></div><p class=\"mb-5 text-center font-pixel text-lg text-cream-50/55\">a mock date, run by two agents</p><div class=\"space-y-3\"><div class=\"flex justify-start\"><div class=\"max-w-[82%] border-2 px-4 py-2.5 text-sm rounded-2xl rounded-tl-sm border-cream-50/15 bg-ink-900 text-cream-50/85\"><span class=\"mb-0.5 block text-[10px] font-bold uppercase tracking-wider text-gold-300\">Your agent</span>She is secure, low-drama, big on family and depth. Wants a real partner. What is yours actually after?</div></div><div class=\"flex justify-end\"><div class=\"max-w-[82%] border-2 px-4 py-2.5 text-sm rounded-2xl rounded-tr-sm border-black bg-gold-500 text-white\"><span class=\"mb-0.5 block text-[10px] font-bold uppercase tracking-wider text-white/70\">Their agent</span>Same page on kids and pace, no dealbreakers either way. They would talk through dinner.</div></div><div class=\"flex justify-start\"><div class=\"max-w-[82%] border-2 px-4 py-2.5 text-sm rounded-2xl rounded-tl-sm border-cream-50/15 bg-ink-900 text-cream-50/85\"><span class=\"mb-0.5 block text-[10px] font-bold uppercase tracking-wider text-gold-300\">Your agent</span>Agreed, nothing here would blow up. Strong on attachment and values. Worth a real evening.</div></div></div><p class=\"mt-5 flex items-center justify-center gap-2 text-center font-pixel text-xl text-gold-300\">no dealbreakers · introduced</p></div></div></div></section><section class=\"border-y-2 border-black bg-gold-600\"><div class=\"mx-auto grid max-w-6xl gap-8 px-6 py-16 sm:grid-cols-3\"><div class=\"text-center\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><p class=\"font-pixel text-6xl text-cream-50 md:text-7xl\">One</p><p class=\"mx-auto mt-2 max-w-[14rem] text-sm font-medium text-cream-50/85\">considered introduction at a time</p></div><div class=\"text-center\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 100ms, transform 0.7s cubic-bezier(0.2,0,0,1) 100ms\"><p class=\"font-pixel text-6xl text-cream-50 md:text-7xl\">Zero</p><p class=\"mx-auto mt-2 max-w-[14rem] text-sm font-medium text-cream-50/85\">swipes, feeds or like counts</p></div><div class=\"text-center\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 200ms, transform 0.7s cubic-bezier(0.2,0,0,1) 200ms\"><p class=\"font-pixel text-6xl text-cream-50 md:text-7xl\">Real</p><p class=\"mx-auto mt-2 max-w-[14rem] text-sm font-medium text-cream-50/85\">chemistry, judged before you ever meet</p></div></div></section><section class=\"mx-auto max-w-6xl px-6 py-24\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><h2 class=\"mb-12 text-center font-display text-4xl font-light tracking-tight text-cream-50 md:text-5xl\">Built like a friend with taste, <br class=\"hidden sm:block\"/> not an algorithm with a quota.</h2></div><div class=\"grid gap-8 md:grid-cols-3\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><article class=\"h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-8 transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.02]\" style=\"transform:rotate(-2deg)\"><span class=\"font-pixel text-3xl text-gold-400\">0<!-- -->1</span><h3 class=\"mt-3 font-display text-2xl tracking-tight text-cream-50\">Hand curated</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">Every introduction is reviewed by a real matchmaker. Our AI helps them, it never replaces them.</p></article></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 110ms, transform 0.7s cubic-bezier(0.2,0,0,1) 110ms\"><article class=\"h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-8 transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.02]\" style=\"transform:rotate(2deg)\"><span class=\"font-pixel text-3xl text-gold-400\">0<!-- -->2</span><h3 class=\"mt-3 font-display text-2xl tracking-tight text-cream-50\">Personality first</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">We match on how you think, communicate and connect, on your intentions, not your filters.</p></article></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 220ms, transform 0.7s cubic-bezier(0.2,0,0,1) 220ms\"><article class=\"h-full rounded-2xl border-2 border-cream-50/10 bg-ink-700 p-8 transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.02]\" style=\"transform:rotate(-1.5deg)\"><span class=\"font-pixel text-3xl text-gold-400\">0<!-- -->3</span><h3 class=\"mt-3 font-display text-2xl tracking-tight text-cream-50\">Private by design</h3><p class=\"mt-3 text-sm leading-relaxed text-cream-50/65\">Only your match can see your profile. No like counts, no public metrics, nothing to perform.</p></article></div></div></section><section class=\"relative overflow-hidden border-y border-cream-50/10 bg-ink-800\"><div class=\"mx-auto max-w-6xl px-6 py-24\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><p class=\"font-pixel text-2xl text-gold-400\">real moments</p><h2 class=\"mt-2 max-w-xl font-display text-4xl font-light tracking-tight text-cream-50 md:text-5xl\">The point was never the app. It was the evening that came after.</h2></div><div class=\"mt-14 flex flex-wrap items-center justify-center gap-x-2 gap-y-8 sm:gap-x-6\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(-5deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-beach-dance.png\" alt=\"Dancing at golden hour on the sand\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For the golden hours</figcaption></figure></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 90ms, transform 0.7s cubic-bezier(0.2,0,0,1) 90ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(4deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-hands-flower.png\" alt=\"Holding hands, carrying a flower\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For fresh blooms</figcaption></figure></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 180ms, transform 0.7s cubic-bezier(0.2,0,0,1) 180ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(-3deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-alley-night.png\" alt=\"Carried home through an old town alley\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For the long way home</figcaption></figure></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(5deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-beach-run.png\" alt=\"Running barefoot along the shore\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For barefoot nights</figcaption></figure></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 90ms, transform 0.7s cubic-bezier(0.2,0,0,1) 90ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(-4deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-car-night.png\" alt=\"Laughing together on a late drive\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For quiet nights</figcaption></figure></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 180ms, transform 0.7s cubic-bezier(0.2,0,0,1) 180ms\"><figure class=\"group relative inline-block rounded-[6px] border-2 border-black bg-cream-50 p-2.5 pb-3 shadow-retro transition-transform duration-base ease-spring hover:rotate-0 hover:scale-[1.03] z-10\" style=\"transform:rotate(3deg)\"><span aria-hidden=\"true\" class=\"absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-[-4deg] rounded-[2px] bg-gold-400/70 shadow-sm backdrop-blur-sm\"></span><img src=\"/brand/couple-hands-flower.png\" alt=\"A real connection\" loading=\"lazy\" class=\"object-cover rounded-[3px] h-48 w-44 sm:h-56 sm:w-52\"/><figcaption class=\"mt-2 text-center font-display text-sm italic text-ink-900/80\">For the real thing</figcaption></figure></div></div></div></section><section class=\"mx-auto max-w-3xl px-6 py-24\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><p class=\"font-pixel text-2xl text-gold-400\">questions, answered</p><h2 class=\"mt-2 font-display text-4xl font-light tracking-tight text-cream-50 md:text-5xl\">The honest FAQ.</h2></div><div class=\"mt-12 space-y-3\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><details class=\"group rounded-2xl border-2 border-cream-50/10 bg-ink-700 px-6 py-5 transition-colors open:border-gold-500/40 hover:border-gold-500/30\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg tracking-tight text-cream-50\">Is this a swiping app?<span class=\"grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-gold-500/50 text-gold-400 transition-transform duration-base group-open:rotate-45\">+</span></summary><p class=\"mt-4 text-sm leading-relaxed text-cream-50/70\">No. There is no endless feed, no like counts, no leaderboards. You receive one considered introduction at a time and nothing else competes for your attention.</p></details></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 80ms, transform 0.7s cubic-bezier(0.2,0,0,1) 80ms\"><details class=\"group rounded-2xl border-2 border-cream-50/10 bg-ink-700 px-6 py-5 transition-colors open:border-gold-500/40 hover:border-gold-500/30\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg tracking-tight text-cream-50\">What do you mean by AI agents?<span class=\"grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-gold-500/50 text-gold-400 transition-transform duration-base group-open:rotate-45\">+</span></summary><p class=\"mt-4 text-sm leading-relaxed text-cream-50/70\">After your onboarding, we build a private AI persona of you. Before any introduction, your agent has short mock conversations with other members’ agents in the background, stress-testing for dealbreakers, attachment traps and quiet red flags. Its job is subtraction: rule out who would never work, so the match you receive is one you could not have ruled out yourself.</p></details></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 160ms, transform 0.7s cubic-bezier(0.2,0,0,1) 160ms\"><details class=\"group rounded-2xl border-2 border-cream-50/10 bg-ink-700 px-6 py-5 transition-colors open:border-gold-500/40 hover:border-gold-500/30\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg tracking-tight text-cream-50\">Can you predict who I will fall for?<span class=\"grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-gold-500/50 text-gold-400 transition-transform duration-base group-open:rotate-45\">+</span></summary><p class=\"mt-4 text-sm leading-relaxed text-cream-50/70\">No, and we will not pretend to. The research is clear that what people say before meeting barely predicts long-term happiness, so we do not sell prophecy. What we do is remove the people you could never work with, the clashing life goals, the anxious-avoidant traps, and kill the wasted first dates. Whether you click is for the two of you to find out, in person.</p></details></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 240ms, transform 0.7s cubic-bezier(0.2,0,0,1) 240ms\"><details class=\"group rounded-2xl border-2 border-cream-50/10 bg-ink-700 px-6 py-5 transition-colors open:border-gold-500/40 hover:border-gold-500/30\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg tracking-tight text-cream-50\">Who can join?<span class=\"grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-gold-500/50 text-gold-400 transition-transform duration-base group-open:rotate-45\">+</span></summary><p class=\"mt-4 text-sm leading-relaxed text-cream-50/70\">Verified adults who are dating with intention. We keep the community small and trustworthy.</p></details></div><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 320ms, transform 0.7s cubic-bezier(0.2,0,0,1) 320ms\"><details class=\"group rounded-2xl border-2 border-cream-50/10 bg-ink-700 px-6 py-5 transition-colors open:border-gold-500/40 hover:border-gold-500/30\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg tracking-tight text-cream-50\">Is my information private?<span class=\"grid h-7 w-7 shrink-0 place-items-center rounded-full border-2 border-gold-500/50 text-gold-400 transition-transform duration-base group-open:rotate-45\">+</span></summary><p class=\"mt-4 text-sm leading-relaxed text-cream-50/70\">Only your match sees your profile. We never sell your data, never show who viewed you, and ask the AI to read only what it needs to make a thoughtful introduction.</p></details></div></div></section><section class=\"mx-auto max-w-6xl px-6 pb-28\"><div class=\"\" style=\"opacity:0;transform:translateY(28px);transition:opacity 0.7s cubic-bezier(0.2,0,0,1) 0ms, transform 0.7s cubic-bezier(0.2,0,0,1) 0ms\"><div class=\"grain relative overflow-hidden rounded-[2rem] border-2 border-black bg-gold-500 px-8 py-16 text-center shadow-retro\"><div class=\"pointer-events-none absolute -left-6 top-6 animate-float-slow\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-cream-50 text-ink-900  \" style=\"transform:rotate(-14deg)\">no swiping</span></div><div class=\"pointer-events-none absolute -right-3 bottom-8 animate-float\"><span class=\"inline-flex items-center gap-1.5 rounded-full border-2 border-black px-3 py-1 text-xs font-bold uppercase tracking-wider shadow-[3px_3px_0_0_rgba(0,0,0,0.85)] bg-black text-cream-50  \" style=\"transform:rotate(12deg)\">with intent</span></div><p class=\"font-pixel text-4xl text-white md:text-6xl\">ready to meet someone real?</p><p class=\"mx-auto mt-5 max-w-md text-base text-white/90\">Tell us a little about yourself and your matchmaker takes it from there.</p><div class=\"mt-8 flex justify-center\"><a href=\"/waitlist\"><button class=\"group relative i